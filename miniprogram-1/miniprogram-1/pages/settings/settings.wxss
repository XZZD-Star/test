page {
  background-color: #f2f4f8;
  min-height: 100vh;
}
.settings-page {
  padding: 30rpx;
  padding-bottom: 60rpx;
}
.header {
  padding: 0 10rpx;
}
.section-title {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 0;
  padding-left: 10rpx;
  font-weight: bold;
}
.edit-btn {
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: rgba(47,84,235,0.1);
  border-radius: 30rpx;
}
.mb-0 { margin-bottom: 0 !important; }

.settings-card {
  padding: 0 30rpx;
}
.s-item {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
  min-height: 100rpx;
}
.s-item:last-child {
  border-bottom: none;
}
.s-label {
  font-size: 30rpx;
  color: var(--text-main);
  flex-shrink: 0;
}
.s-val {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: right;
  flex: 1;
}
.s-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: bold;
  height: 50rpx;
  min-height: 50rpx;
}

.mr-20 { margin-right: 20rpx; }
radio { transform: scale(0.8); }
switch { transform: scale(0.85) translateX(10rpx); }

/* 保存按钮精准居中方案 */
.btn-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}
.save-btn {
  background: var(--primary-color) !important;
  color: #fff !important;
  width: 100% !important;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(47, 84, 235, 0.3);
}
.save-btn::after {
  border: none;
}
