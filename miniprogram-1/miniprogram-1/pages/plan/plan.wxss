page {
  background-color: #f2f4f8;
  min-height: 100vh;
}
.plan-page {
  padding: 30rpx;
}
.text-sm {
  font-size: 24rpx;
  line-height: 1.5;
  padding: 0 10rpx;
}
.section-title {
  font-size: 32rpx;
  padding-left: 10rpx;
}
.plan-list {
  padding: 0 30rpx;
}
.plan-item {
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.plan-item:last-child {
  border-bottom: none;
}
.action-name {
  display: flex;
  flex-direction: column;
}
.key-text {
  font-size: 22rpx;
  color: var(--text-muted);
}
.stepper {
  background: #f7f8fa;
  border-radius: 40rpx;
  overflow: hidden;
}
.step-btn {
  width: 70rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}
.step-btn:active {
  background: #eee;
}
.minus { color: var(--text-sub); }
.plus { color: var(--primary-color); }
.step-input {
  width: 80rpx;
  height: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  background: transparent;
  color: var(--text-main);
  border-left: 2rpx solid #e8e8e8;
  border-right: 2rpx solid #e8e8e8;
}

.action-wrap {
  gap: 20rpx;
}
.round-btn {
  border-radius: 45rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 0 !important;
  box-sizing: border-box;
}
.btn-outline {
  background: transparent !important;
  color: var(--text-sub) !important;
  border: 2rpx solid #d9d9d9;
}
.mr-20 { margin-right: 20rpx !important; }
