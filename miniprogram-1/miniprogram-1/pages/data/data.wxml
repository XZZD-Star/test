<view class="container data-page page-enter">
  
  <view class="section-title font-bold mb-20 mt-10">今日总结</view>
  <view class="summary-card card mb-40 flex justify-between">
    <view class="flex-col align-center">
      <text class="s-val text-primary">{{todaySummary.percent}}%</text>
      <text class="s-label">完成率</text>
    </view>
    <view class="flex-col align-center">
      <text class="s-val">{{todaySummary.duration}}</text>
      <text class="s-label">训练时长</text>
    </view>
    <view class="flex-col align-center">
      <text class="s-val">{{todaySummary.count}}</text>
      <text class="s-label">动作数</text>
    </view>
  </view>

  <!-- 动作统计区 -->
  <view class="section-title font-bold mb-20">动作累计统计</view>
  <view class="stats-card card mb-40">
    <view class="flex justify-between align-center mb-20">
      <text class="text-main">侧平举</text>
      <text class="font-bold border-bottom">{{actionStats.cepingju}} 次</text>
    </view>
    <view class="flex justify-between align-center mb-20">
      <text class="text-main">前屈上举</text>
      <text class="font-bold border-bottom">{{actionStats.qianqu}} 次</text>
    </view>
    <view class="flex justify-between align-center">
      <text class="text-main">曲臂（腕举）</text>
      <text class="font-bold border-bottom">{{actionStats.qubi}} 次</text>
    </view>
  </view>

  <view class="section-title font-bold mb-20">历史训练记录</view>
  <view class="history-list">
    <view class="card record-card flex justify-between align-center" wx:for="{{historyList}}" wx:key="date" bindtap="goDetail" data-item="{{item}}" hover-class="none">
      <view class="flex-col">
        <text class="font-bold mb-10">{{item.date}}</text>
        <text class="text-muted">时长: {{item.duration}}</text>
      </view>
      <view class="flex align-center">
        <view class="percent-circle mr-20 {{item.status === 'warning' ? 'circle-warning' : 'circle-success'}}">
          <text>{{item.percent}}%</text>
        </view>
        <text class="text-sub">〉</text>
      </view>
    </view>
  </view>

</view>