<view class="container mine-page">
  
  <view class="user-card card flex align-center mb-30" bindtap="goToPage" data-url="/pages/settings/settings">
    <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
    <view class="flex-col ml-30 flex-1">
      <view class="flex justify-between align-center">
        <text class="nickname font-bold">{{userInfo.nickName}}</text>
        <view class="tag-primary tag-mini">去设置 〉</view>
      </view>
      <text class="target-text mt-10">当前目标: {{target}}</text>
      <text class="days-text mt-10">已连续训练 <text class="font-bold text-primary">{{continueDays}}</text> 天</text>
    </view>
  </view>

  <view class="list-card card mb-30">
    <view class="list-item" bindtap="goToPage" data-url="/pages/plan/plan">
      <text class="item-title">我的计划</text>
      <text class="item-arrow">〉</text>
    </view>
    <view class="list-item" bindtap="goToPage" data-url="/pages/data/data">
      <text class="item-title">训练记录</text>
      <text class="item-arrow">〉</text>
    </view>
    <view class="list-item" bindtap="goToPage" data-url="/pages/health/health">
      <text class="item-title">健康档案</text>
      <text class="item-arrow">〉</text>
    </view>
    <view class="list-item" bindtap="goToPage" data-url="/pages/device/device">
      <text class="item-title">设备状态</text>
      <text class="item-arrow">〉</text>
    </view>
  </view>

  <view class="list-card card mb-30">
    <view class="list-item" bindtap="goToPage" data-url="/pages/feedback/feedback">
      <text class="item-title">功能建议</text>
      <text class="item-arrow">〉</text>
    </view>
    <view class="list-item" bindtap="goToPage" data-url="/pages/about/about">
      <text class="item-title">关于项目</text>
      <text class="item-arrow">〉</text>
    </view>
  </view>

  <view class="footer-note flex-col align-center mt-40">
    <text>康复辅助助手 v1.1.0</text>
    <text class="mt-10 mb-20">数据仅供参考，如有不适请立即就医</text>
  </view>
</view>