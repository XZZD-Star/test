@import "styles/theme.wxss";
@import "styles/common.wxss";

page {
  width: 100%;
  height: 100%;
  min-height: 100vh; /* 使用 vh 强行铺满整屏，结合 height 100% 修复弹性盒子坍塌 */
  display: flex;
  flex-direction: column;
  background-color: #f2f4f8;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-main);
  box-sizing: border-box;
  font-size: 28rpx;
}

view, text, image, scroll-view {
  box-sizing: border-box;
}

/* Base button override */
button::after {
  border: none;
}
button {
  border-radius: var(--border-radius-md);
  font-size: 32rpx;
  font-weight: bold;
}
.btn-primary {
  background: var(--primary-color) !important;
  color: #fff !important;
  box-shadow: 0 8rpx 16rpx rgba(47, 84, 235, 0.3) !important;
}
.btn-primary:active {
  opacity: 0.8;
}
