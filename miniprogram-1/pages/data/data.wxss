page {
  background-color: #f2f4f8;
  min-height: 100vh;
}
.data-page {
  padding: 30rpx;
}
.section-title {
  font-size: 32rpx;
  color: var(--text-main);
}
.summary-card {
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, rgba(47, 84, 235, 0.05) 0%, rgba(47, 84, 235, 0.1) 100%);
  border: 2rpx solid rgba(47, 84, 235, 0.1);
}
.s-val { font-size: 36rpx; font-weight: bold; margin-bottom: 10rpx;}
.s-label { font-size: 24rpx; color: var(--text-sub); }

.stats-card {
  padding: 30rpx;
}
.border-bottom {
  font-size: 32rpx;
}

.record-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}
.record-card:active {
  transform: scale(0.98);
}
.mr-20 { margin-right: 20rpx; }
.percent-circle {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: bold;
}
.circle-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}
.circle-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--warning-color);
}
